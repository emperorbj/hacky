ARCJET_KEY=ajkey_yourkey
# Only for local development — lets Arcjet fingerprint requests from localhost.
# Do not set this in production.
ARCJET_ENV=development

API_KEY=your-local-api-key

DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

STRIPE_SECRET_KEY=sk_test_yourkey
# From Stripe Dashboard -> Webhooks, after registering the endpoint
# (use the Stripe CLI for local testing: stripe listen --forward-to localhost:3000/payments/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_yourkey

# No real frontend exists in this project yet — Stripe still requires a real
# absolute URL to redirect to after checkout. Any value works for testing;
# swap this for the real frontend's URL once one exists.
FRONTEND_URL=http://localhost:5173

REDIS_URL=rediss://default:yourpassword@your-upstash-endpoint:6379

# Seeded via `npm run seed` — ensures one RECRUITER account exists without
# needing an admin role-management system. Safe to re-run (idempotent).
DEFAULT_RECRUITER_EMAIL=recruiter@example.com
DEFAULT_RECRUITER_PASSWORD=replace-with-a-real-password
